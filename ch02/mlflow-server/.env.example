# 복사해서 사용: cp .env.example .env
# 실습용 기본값입니다. 외부에 공개되는 서버라면 반드시 바꾸세요.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow-password
S3_ACCESS_KEY=mlops-admin
S3_SECRET_KEY=mlops-secret-key

# 학습 코드를 다른 PC에서 실행한다면 이 서버의 주소로 바꾸세요 (예: http://192.0.2.10:9000)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# 다른 PC의 브라우저에서 MLflow UI를 연다면 그 주소를 적으세요 (예: http://192.0.2.10:5000)
# 비워 두면 http://localhost 접속만 허용됩니다.
UI_ALLOWED_ORIGINS=
